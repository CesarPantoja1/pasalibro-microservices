# ============================================
# PasaLibro Microservices — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to the repository.
# ============================================

# ── General ──────────────────────────────────
FLASK_ENV=development
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600

# ── Azure PostgreSQL ─────────────────────────
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=pasalibro
DB_SSL_MODE=require

# ── MS-Users Database Credentials ────────────
DB_USER_USERS=usr_ms_users
DB_PASS_USERS=change-me
DB_SCHEMA_USERS=schema_users

# ── MS-Books Database Credentials ────────────
DB_USER_BOOKS=usr_ms_books
DB_PASS_BOOKS=change-me
DB_SCHEMA_BOOKS=schema_books

# ── MS-Chat Database Credentials ─────────────
DB_USER_CHAT=usr_ms_chat
DB_PASS_CHAT=change-me
DB_SCHEMA_CHATS=schema_chats

# ── Service Ports (internal) ─────────────────
MS_USERS_PORT=5001
MS_BOOKS_PORT=5002
MS_CHAT_PORT=5003

# ── Cloudflare Tunnel (production only) ──────
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ── Monitoring ───────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
